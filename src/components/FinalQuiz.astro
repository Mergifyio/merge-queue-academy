  /* Beautiful Diploma - Social Media Optimized (1.91:1 aspect ratio) */
  .diploma-wrapper {
    margin-bottom: 2rem;
    overflow-x: auto;
    overflow-y: visible;
  }

  .diploma {
    position: relative;
    background: linear-gradient(135deg, #1a1d24 0%, #13151a 50%, #1a1d24 100%);
    border-radius: 12px;
    box-shadow:
      0 0 0 4px #f59e0b,
      0 0 0 6px #13151a,
      0 0 0 8px #323846,
      0 20px 40px rgba(0, 0, 0, 0.4);
    /* Social media friendly: 1.91:1 aspect ratio */
    width: calc(100% - 20px);
    max-width: 650px;
    margin: 10px auto;
    aspect-ratio: 1.91 / 1;
  }

  .diploma-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 10% 50%, rgba(245, 158, 11, 0.12) 0%, transparent 40%),
      radial-gradient(circle at 90% 50%, rgba(251, 191, 36, 0.12) 0%, transparent 40%),
      radial-gradient(circle at 50% 50%, rgba(245, 158, 11, 0.05) 0%, transparent 60%);
