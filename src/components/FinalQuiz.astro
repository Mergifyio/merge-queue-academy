  }

  .share-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .share-btn {
    margin: 0 !important;
    margin-top: 0 !important;
    padding: 0 1rem;
