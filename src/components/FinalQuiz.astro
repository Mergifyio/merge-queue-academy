  }

  @media (max-width: 600px) {
    .quiz-intro {
      padding: 2rem 1.5rem;
    }

    .quiz-intro h2 {
      font-size: 1.5rem;
    }

    /* On mobile, keep the diploma at a fixed social-media-friendly width and allow horizontal scrolling */
    .diploma-wrapper {
      margin-left: -1rem;
      margin-right: -1rem;
      padding: 0 1rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .diploma {
      min-width: 650px;
    }

    .tf-options {
      grid-template-columns: 1fr;
    }

    .share-buttons {
      flex-direction: column;
    }

    .share-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Load libraries
    const confettiScript = document.createElement('script');
    confettiScript.src = 'https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js';
    document.head.appendChild(confettiScript);

    const html2canvasScript = document.createElement('script');
    html2canvasScript.src = 'https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js';
    document.head.appendChild(html2canvasScript);

    const intro = document.getElementById('quiz-intro');
    const main = document.getElementById('quiz-main');
    const results = document.getElementById('quiz-results');
    const startBtn = document.getElementById('start-quiz');
    const nextBtn = document.getElementById('next-btn');
    const retryBtn = document.getElementById('retry-btn');
    const nameInput = document.getElementById('candidate-name') as HTMLInputElement;

    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');
    const currentScoreEl = document.getElementById('current-score');

    const questions = document.querySelectorAll('.question-card');
    const totalQuestions = questions.length;

    let currentQ = 0;
    let score = 0;
    let answers: boolean[] = [];
    let candidateName = '';

    // Load saved name from localStorage
    const savedName = localStorage.getItem('mqa-quiz-name');
    if (savedName && nameInput) {
      nameInput.value = savedName;
    }

    // Start quiz
    startBtn?.addEventListener('click', () => {
      candidateName = nameInput?.value.trim() || 'Distinguished Graduate';
      // Save name to localStorage
      if (nameInput?.value.trim()) {
        localStorage.setItem('mqa-quiz-name', nameInput.value.trim());
      }
      if (intro) intro.style.display = 'none';
      if (main) main.style.display = 'block';
    });

    // Handle option clicks
    questions.forEach((card, qIndex) => {
      const options = card.querySelectorAll('.option-btn');
      options.forEach(btn => {
        btn.addEventListener('click', () => {
          if (btn.classList.contains('correct') || btn.classList.contains('incorrect')) {
            return;
          }

          const isCorrect = btn.getAttribute('data-correct') === 'true';
          answers[qIndex] = isCorrect;

          options.forEach(o => {
            (o as HTMLButtonElement).disabled = true;
            if (o.getAttribute('data-correct') === 'true') {
              o.classList.add('correct');
            }
          });

          if (!isCorrect) {
            btn.classList.add('incorrect');
          } else {
            score++;
            if (currentScoreEl) currentScoreEl.textContent = score.toString();
          }

          const explanation = card.querySelector('.explanation') as HTMLElement;
          if (explanation) explanation.style.display = 'block';

          if (nextBtn) (nextBtn as HTMLButtonElement).disabled = false;
        });
      });
    });

    // Next question
    nextBtn?.addEventListener('click', () => {
      if (currentQ < totalQuestions - 1) {
        questions[currentQ].style.display = 'none';
        currentQ++;
        questions[currentQ].style.display = 'block';

        const progress = ((currentQ + 1) / totalQuestions) * 100;
        if (progressFill) progressFill.style.width = progress + '%';
        if (progressText) progressText.textContent = `Question ${currentQ + 1} / ${totalQuestions}`;

        (nextBtn as HTMLButtonElement).disabled = true;

        if (currentQ === totalQuestions - 1) {
          nextBtn.textContent = '🎓 See Results';
        }
      } else {
        showResults();
      }
    });

    function showResults() {
      if (main) main.style.display = 'none';
      if (results) results.style.display = 'block';

      // Update name
      const nameEl = document.getElementById('diploma-name');
      if (nameEl) nameEl.textContent = candidateName;

      // Update score
      const finalScoreEl = document.getElementById('final-score');
      if (finalScoreEl) finalScoreEl.textContent = score.toString();

      // Update grade
      const gradeEl = document.getElementById('diploma-grade');
      let grade = '';
      let gradeColor = '';

      if (score === 12) {
        grade = '🏆 Merge Queue Master';
        gradeColor = '#fbbf24';
        fireConfetti();
      } else if (score >= 10) {
        grade = '🥇 Queue Commander';
        gradeColor = '#4ade80';
        fireConfetti();
      } else if (score >= 8) {
        grade = '🥈 Branch Protector';
        gradeColor = '#60a5fa';
      } else if (score >= 6) {
        grade = '🥉 CI Apprentice';
        gradeColor = '#c084fc';
      } else if (score >= 4) {
        grade = '📚 Eager Learner';
        gradeColor = '#f87171';
      } else {
        grade = '🌱 Fresh Start';
        gradeColor = '#8891a5';
      }

      if (gradeEl) {
        gradeEl.textContent = grade;
        gradeEl.style.color = gradeColor;
      }

      // Update date
      const dateEl = document.getElementById('diploma-date');
      if (dateEl) {
        const now = new Date();
        dateEl.textContent = now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      }

      // Build breakdown
      const breakdownEl = document.getElementById('results-breakdown');
      if (breakdownEl) {
        const topics = [
          'Future vs Current State', 'Semantic Conflicts', 'Speculative Checks',
          'Queue Throughput', 'Failure Handling', 'Batching Benefits',
          'Parallel Queues', 'Prerequisites', 'Industry Knowledge',
          'Monorepo Strategies', 'Two-Step CI', 'Not Rocket Science Rule'
        ];

        let html = '<h4 class="breakdown-title">Question Breakdown</h4>';
        answers.forEach((correct, i) => {
          html += `
            <div class="breakdown-item">
              <span class="breakdown-icon">${correct ? '✅' : '❌'}</span>
              <span class="breakdown-text">${topics[i]}</span>
            </div>
          `;
        });
        breakdownEl.innerHTML = html;
      }
    }

    function fireConfetti() {
      if (typeof (window as any).confetti === 'undefined') return;

      (window as any).confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
        colors: ['#f59e0b', '#fbbf24', '#fcd34d', '#4ade80', '#60a5fa']
      });

      setTimeout(() => {
        (window as any).confetti({
          particleCount: 50,
          angle: 60,
          spread: 55,
          origin: { x: 0 },
          colors: ['#f59e0b', '#fbbf24', '#fcd34d']
        });
      }, 250);

      setTimeout(() => {
        (window as any).confetti({
          particleCount: 50,
          angle: 120,
          spread: 55,
          origin: { x: 1 },
          colors: ['#f59e0b', '#fbbf24', '#fcd34d']
        });
      }, 400);
    }

    // Retry
    retryBtn?.addEventListener('click', () => {
      currentQ = 0;
      score = 0;
      answers = [];

      questions.forEach((card, i) => {
        card.style.display = i === 0 ? 'block' : 'none';
        const options = card.querySelectorAll('.option-btn');
        options.forEach(o => {
          o.classList.remove('correct', 'incorrect');
          (o as HTMLButtonElement).disabled = false;
        });
        const explanation = card.querySelector('.explanation') as HTMLElement;
        if (explanation) explanation.style.display = 'none';
      });

      if (progressFill) progressFill.style.width = '8.33%';
      if (progressText) progressText.textContent = 'Question 1 / 12';
      if (currentScoreEl) currentScoreEl.textContent = '0';
      if (nextBtn) {
        nextBtn.textContent = 'Next Question →';
        (nextBtn as HTMLButtonElement).disabled = true;
      }

      if (results) results.style.display = 'none';
      if (intro) intro.style.display = 'block';
    });

    // Download diploma as image
    const downloadBtn = document.getElementById('download-diploma');
    const shareToast = document.getElementById('share-toast');

    downloadBtn?.addEventListener('click', async () => {
      const diploma = document.getElementById('diploma');
      if (!diploma || typeof (window as any).html2canvas === 'undefined') {
        showToast('Please wait for the page to fully load...');
        return;
      }

      showToast('Generating your diploma...');

      try {
        const canvas = await (window as any).html2canvas(diploma, {
          backgroundColor: '#13151a',
          scale: 2,
          useCORS: true,
          logging: false,
        });

        const link = document.createElement('a');
        link.download = `merge-queue-diploma-${candidateName.replace(/\s+/g, '-').toLowerCase()}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();

        showToast('Diploma downloaded! 🎉');
      } catch (err) {
        console.error('Failed to generate diploma:', err);
        showToast('Failed to generate image. Try again.');
      }
    });

    function showToast(message: string) {
      if (shareToast) {
        shareToast.textContent = message;
        shareToast.classList.add('show');
        setTimeout(() => shareToast.classList.remove('show'), 3000);
      }
    }

    // Share buttons
    const shareTwitter = document.getElementById('share-twitter');
    const shareLinkedin = document.getElementById('share-linkedin');

    const getShareText = () => {
      const gradeEl = document.getElementById('diploma-grade');
      const grade = gradeEl?.textContent || '';
      return `🎓 I scored ${score}/12 on the Merge Queue Mastery Exam and earned "${grade}"!\n\nTest your knowledge:`;
    };

    const shareUrl = 'https://merge-queue.academy/decision/final-quiz/';

    shareTwitter?.addEventListener('click', () => {
      const text = encodeURIComponent(getShareText());
      const url = encodeURIComponent(shareUrl);
      window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank');
    });

    shareLinkedin?.addEventListener('click', async () => {
      const text = getShareText() + ' ' + shareUrl;
      // Copy text to clipboard for user to paste
      try {
        await navigator.clipboard.writeText(text);
        showToast('Text copied! Paste it in LinkedIn 📋');
      } catch (e) {
        // Fallback if clipboard fails
      }
      // Open LinkedIn share dialog
      const url = encodeURIComponent(shareUrl);
      window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank');
    });
  });
</script>
