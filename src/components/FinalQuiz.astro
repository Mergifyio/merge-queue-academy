  }

  .diploma-ornament.top-left { top: -0.75rem; left: 0.5rem; transform: rotate(-45deg); }
  .diploma-ornament.top-right { top: -0.75rem; right: 0.5rem; transform: rotate(45deg) scaleX(-1); }
  .diploma-ornament.bottom-left { bottom: 0.5rem; left: 0.5rem; transform: rotate(45deg); }
  .diploma-ornament.bottom-right { bottom: 0.5rem; right: 0.5rem; transform: rotate(-45deg) scaleX(-1); }

  /* Left column */
