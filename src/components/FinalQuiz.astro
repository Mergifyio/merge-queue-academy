    color: var(--mqa-text, #f0f2f5);
    margin: 0 0 1rem 0;
  }

  .breakdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--mqa-border-subtle, #272c37);
