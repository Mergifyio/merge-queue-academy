    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .share-toast.show {
    opacity: 1;
  }

  /* Results breakdown */
  .results-breakdown {
    background: var(--mqa-bg-subtle, #1a1d24);
    border: 1px solid var(--mqa-border-subtle, #272c37);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .breakdown-title {
    font-family: var(--mqa-font-display, 'Space Grotesk', sans-serif);
    font-size: 1rem;
