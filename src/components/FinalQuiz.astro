  .diploma-grade {
    font-family: var(--mqa-font-display, 'Space Grotesk', sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    background: #21252e;
    border-radius: 18px;
    border: 1px solid #323846;
