  }

  /* Retry section */
  .retry-section {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .retry-btn {
    padding: 0.875rem 1.5rem;
    background: var(--mqa-bg-muted, #21252e);
    border: 1px solid var(--mqa-border, #323846);
    border-radius: 8px;
    color: var(--mqa-text-secondary, #b4bcd0);
    font-family: var(--mqa-font-sans, 'Instrument Sans', sans-serif);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .retry-btn:hover {
    border-color: var(--mqa-text-muted, #8891a5);
    color: var(--mqa-text, #f0f2f5);
  }

  .home-link {
    color: var(--mqa-text-muted, #8891a5) !important;
    font-size: 0.9rem;
    text-decoration: none !important;
    transition: color 0.2s ease;
  }

  .home-link:hover {
