---
import config from 'virtual:starlight/user-config';
import type { Props } from '@astrojs/starlight/props';

const currentYear = new Date().getFullYear();
---

<footer class="custom-footer">
  <div class="footer-content">
    <div class="footer-love">
      <span class="love-text">
        Written with
        <span class="heart" aria-label="love">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        </span>
        by the <a href="https://mergify.com" target="_blank" rel="noopener">Mergify</a> team
      </span>
    </div>
  </div>
</footer>

<style>
  .custom-footer {
    margin-top: 3rem;
    padding: 2rem 1rem;
    border-top: 1px solid var(--mqa-border-subtle, #272c37);
    background: linear-gradient(180deg, transparent, rgba(19, 21, 26, 0.5));
  }

  .footer-content {
    max-width: var(--sl-content-width);
    margin: 0 auto;
    text-align: center;
  }

  .footer-love {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 1.25rem;
    background: var(--mqa-bg-subtle, #1a1d24);
    border: 1px solid var(--mqa-border-subtle, #272c37);
    border-radius: 100px;
    font-family: var(--mqa-font-sans, system-ui, sans-serif);
    font-size: 0.85rem;
    color: var(--mqa-text-muted, #8891a5);
  }

  .love-text {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .heart {
    display: inline-flex;
    color: var(--mqa-ci-fail, #f87171);
    animation: heartbeat 1.5s ease-in-out infinite;
  }

  .heart svg {
    width: 14px;
    height: 14px;
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .footer-love a {
    color: var(--mqa-accent, #f59e0b);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .footer-love a:hover {
    color: var(--mqa-accent-hover, #fbbf24);
    text-decoration: underline;
  }
</style>
