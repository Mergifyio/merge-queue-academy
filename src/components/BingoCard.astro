---
interface Props {
  items: string[];
  title?: string;
}

const { items, title = "Merge Queue Bingo" } = Astro.props;

// Ensure we have exactly 16 items for a 4x4 grid
const gridItems = items.slice(0, 16);
while (gridItems.length < 16) {
  gridItems.push('Free Space');
}
---

<div class="bingo-container">
  <h3 class="bingo-title">{title}</h3>
  <p class="bingo-subtitle">Click each pain point you've experienced</p>
  <div class="bingo-grid" id="bingo-grid">
    {gridItems.map((item, index) => (
      <button
        class="bingo-cell"
        data-index={index}
        type="button"
      >
        <span class="cell-text">{item}</span>
        <span class="cell-check">✓</span>
      </button>
    ))}
  </div>
  <div class="bingo-score">
    <div class="score-line"><span class="score-count">0</span> / 16 checked</div>
    <div class="score-message"></div>
    <div class="fireworks" id="fireworks"></div>
  </div>
</div>

<style>
  .bingo-container {
    margin: 2rem 0;
    padding: 1.5rem 1.5rem 2.5rem;
    background: var(--mqa-bg-subtle, #1a1d24);
    border: 1px solid var(--mqa-border-subtle, #272c37);
    border-radius: 12px;
  }

  .bingo-title {
    font-family: var(--mqa-font-display, 'Space Grotesk', sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--mqa-text, #f0f2f5);
    margin: 0 0 0.25rem 0;
    text-align: center;
  }

  .bingo-subtitle {
    font-size: 0.875rem;
    color: var(--mqa-text-muted, #8891a5);
    text-align: center;
    margin: 0 0 1.25rem 0;
  }

  .bingo-grid {
    display: grid;
    grid-template-columns: repeat(4, 100px);
    grid-auto-rows: 100px;
    gap: 8px;
    justify-content: center;
    align-items: stretch;
    margin: 0 auto;
  }

  .bingo-cell {
    position: relative;
    margin: 0;
    padding: 0.5rem;
    background: var(--mqa-bg-muted, #21252e);
    border: 2px solid var(--mqa-border, #323846);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--mqa-font-sans, 'Instrument Sans', sans-serif);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--mqa-text-secondary, #b4bcd0);
    line-height: 1.3;
    overflow: hidden;
    align-self: stretch;
    justify-self: stretch;
  }

  .bingo-cell:hover {
    border-color: var(--mqa-accent, #f59e0b);
    background: var(--mqa-bg-elevated, #282d38);
  }

  .bingo-cell.checked {
    background: rgba(245, 158, 11, 0.15);
    border-color: var(--mqa-accent, #f59e0b);
    color: var(--mqa-text, #f0f2f5);
  }

  .bingo-cell.checked .cell-check {
    opacity: 1;
    transform: scale(1);
  }

  .cell-text {
    z-index: 1;
  }

  .cell-check {
    position: absolute;
    top: 4px;
    right: 4px;
    font-size: 0.75rem;
    color: var(--mqa-accent, #f59e0b);
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease;
  }

  .bingo-score {
    text-align: center;
    margin-top: 1.25rem;
    font-family: var(--mqa-font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.9375rem;
    color: var(--mqa-text-secondary, #b4bcd0);
  }

  .score-count {
    font-weight: 600;
    color: var(--mqa-accent, #f59e0b);
  }

  .score-line {
    margin-bottom: 0.5rem;
  }

  .score-message {
    font-family: var(--mqa-font-sans, 'Instrument Sans', sans-serif);
    font-size: 0.875rem;
    min-height: 1.25rem;
  }

  .score-message.warning {
    color: var(--mqa-accent, #f59e0b);
  }

  .score-message.danger {
    color: var(--mqa-red, #f87171);
  }

  .fireworks {
    position: relative;
    height: 0;
    overflow: visible;
  }

  .firework {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    animation: firework 0.8s ease-out forwards;
  }

  @keyframes firework {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 1;
    }
    100% {
      transform: translate(var(--tx), var(--ty)) scale(0);
      opacity: 0;
    }
  }

  @media (max-width: 480px) {
    .bingo-grid {
      grid-template-columns: repeat(4, 72px);
      grid-auto-rows: 72px;
      gap: 6px;
    }
    .bingo-cell {
      font-size: 0.55rem;
      padding: 0.375rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('bingo-grid');
    if (!grid) return;

    const cells = grid.querySelectorAll('.bingo-cell');
    const scoreCount = document.querySelector('.score-count');
    const scoreMessage = document.querySelector('.score-message');
    const fireworksContainer = document.getElementById('fireworks');
    let previousChecked = 0;

    cells.forEach(cell => {
      cell.addEventListener('click', () => {
        cell.classList.toggle('checked');
        updateScore();
      });
    });

    function createFireworks() {
      if (!fireworksContainer) return;
      const colors = ['#f59e0b', '#fbbf24', '#fcd34d', '#fef3c7'];
      for (let i = 0; i < 12; i++) {
        const spark = document.createElement('div');
        spark.className = 'firework';
        spark.style.background = colors[Math.floor(Math.random() * colors.length)];
        spark.style.left = '50%';
        spark.style.top = '-10px';
        const angle = (Math.PI * 2 * i) / 12;
        const distance = 30 + Math.random() * 20;
        spark.style.setProperty('--tx', `${Math.cos(angle) * distance}px`);
        spark.style.setProperty('--ty', `${Math.sin(angle) * distance - 20}px`);
        fireworksContainer.appendChild(spark);
        setTimeout(() => spark.remove(), 800);
      }
    }

    function updateScore() {
      const checked = grid.querySelectorAll('.bingo-cell.checked').length;
      if (scoreCount) scoreCount.textContent = checked.toString();

      // Trigger fireworks at thresholds
      if ((checked === 4 || checked === 8 || checked === 12) && checked > previousChecked) {
        createFireworks();
      }
      previousChecked = checked;

      if (scoreMessage) {
        scoreMessage.className = 'score-message';
        if (checked >= 12) {
          scoreMessage.textContent = '🚨 You desperately need a merge queue';
          scoreMessage.classList.add('danger');
        } else if (checked >= 8) {
          scoreMessage.textContent = '⚠️ A merge queue would help your team significantly';
          scoreMessage.classList.add('warning');
        } else if (checked >= 4) {
          scoreMessage.textContent = '💡 You might benefit from a merge queue';
        } else {
          scoreMessage.textContent = '';
        }
      }
    }
  });
</script>
